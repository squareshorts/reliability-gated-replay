{
  "data": {
    "name": "split_cifar10",
    "task_il": true,
    "n_classes": 10,
    "classes_per_task": 2,
    "normalize": true,
    "val_fraction": 0.05,
    "max_train_per_task": 2500,
    "max_test_per_task": 1000,
    "allow_download": true,
    "seed": 2,
    "label_noise": {
      "rate": 0.2,
      "schedule": "all",
      "noise_type": "symmetric"
    }
  },
  "method": {
    "name": "irgr",
    "buffer_size": 500,
    "batch_size": 32,
    "base_method": "derpp",
    "teacher_momentum": 0.99,
    "derpp_alpha": 0.5,
    "derpp_beta": 1.0,
    "seed": 2
  },
  "train": {
    "epochs": 8,
    "batch_size": 128
  }
}